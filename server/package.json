{
  "name": "hisaab-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute hisaab --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute hisaab --file=./schema.sql --local"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "wrangler": "^3.90.0",
    "@cloudflare/workers-types": "^4.20241106.0"
  }
}
